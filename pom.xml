<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <parent>
    <groupId>org.opengis.cite</groupId>
    <artifactId>ets-common</artifactId>
    <version>9</version>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <groupId>org.opengis.cite</groupId>
  <artifactId>swecommon30-parent</artifactId>
  <version>0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SWE Common 3.0 Conformance Test Suite Parent</name>
  <description>Parent project for SWE Common 3.0 validation and ETS modules.</description>
  <url>http://opengeospatial.github.io/ets-swecommon30/</url>

  <organization>
    <name>Open Geospatial Consortium</name>
    <url>http://www.opengeospatial.org/</url>
  </organization>

  <scm>
    <connection>scm:git:https://github.com/opengeospatial/ets-swecommon30.git</connection>
    <developerConnection>scm:git:git@github.com:opengeospatial/ets-swecommon30.git</developerConnection>
    <url>https://github.com/opengeospatial/ets-swecommon30</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issue Tracker</system>
    <url>https://github.com/opengeospatial/ets-swecommon30/issues</url>
  </issueManagement>

  <modules>
    <module>swecommon30-validator</module>
    <module>swecommon30-ets</module>
  </modules>

  <properties>
    <ets-code>swecommon30</ets-code>
    <spec-version>1.0</spec-version>
    <docker.teamengine.version>5.7</docker.teamengine.version>
    <networknt.version>1.5.4</networknt.version>
    <jackson.version>2.17.2</jackson.version>
  </properties>

  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>2.10.4</version>
        <reportSets>
          <reportSet>
            <id>default</id>
            <configuration>
              <docfilessubdirs>true</docfilessubdirs>
              <show>package</show>
              <links combine.self="override"/>
            </configuration>
            <reports>
              <report>javadoc</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>

</project>
