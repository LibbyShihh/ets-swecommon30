{
  "type": "PhysicalSystem",
  "uniqueId": "urn:example:sensors:weather-station-003",
  "label": "Example Weather Station",
  "definition": "http://www.w3.org/ns/sosa/ObservingProcedure",
  "outputs": [
    {
      "name": "weather",
      "type": "DataRecord",
      "label": "Weather Data Record",
