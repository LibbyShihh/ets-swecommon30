      <gml:CoordinateSystemAxis gml:id="lat" uom="deg">
        <gml:axisAbbrev>Lat</gml:axisAbbrev>
        <gml:axisDirection codeSpace="EPSG">north</gml:axisDirection>
      </gml:CoordinateSystemAxis>
    </gml:axis>
    <gml:axis>
