{
  "type": "DataStream",
  "label": "Navigation data",
  "elementType": {
    "name": "navData",
    "type": "DataRecord",
    "fields": [
      {
        "name": "time",
        "type": "Time",
        "definition": "http://www.opengis.net/def/property/OGC/0/SamplingTime",
        "uom": { "href": "http://www.opengis.net/def/uom/ISO-8601/0/Gregorian" }
      },
      { "name": "speed", "type": "Quantity", "definition": "http://example.org/def/speed", "uom": { "code": "m/s" } },
      {
        "name": "location",
        "type": "Vector",
        "definition": "http://example.org/def/location",
        "referenceFrame": "http://www.opengis.net/def/crs/EPSG/0/4979",
        "coordinates": [
          { "name": "lat", "type": "Quantity", "definition": "http://example.org/def/lat", "uom": { "code": "deg" } },
          { "name": "lon", "type": "Quantity", "definition": "http://example.org/def/lon", "uom": { "code": "deg" } },
          { "name": "alt", "type": "Quantity", "definition": "http://example.org/def/alt", "uom": { "code": "m" } }
        ]
      },
      {
        "name": "wind",
        "type": "DataRecord",
        "fields": [
          { "name": "speed", "type": "Quantity", "definition": "http://example.org/def/windSpeed", "uom": { "code": "m/s" } },
          { "name": "direction", "type": "Quantity", "definition": "http://example.org/def/windDirection", "uom": { "code": "deg" } }
        ]
      }
    ]
  },
  "encoding": { "type": "JSONEncoding" }
}
