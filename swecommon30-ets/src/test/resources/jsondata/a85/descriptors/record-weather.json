{
  "type": "DataRecord",
  "label": "Weather observation",
  "fields": [
    {
      "name": "time",
      "type": "Time",
      "definition": "http://www.opengis.net/def/property/OGC/0/SamplingTime",
      "uom": { "href": "http://www.opengis.net/def/uom/ISO-8601/0/Gregorian" }
    },
    { "name": "temp", "type": "Quantity", "definition": "http://example.org/def/temp", "uom": { "code": "Cel" } },
    { "name": "press", "type": "Quantity", "optional": true, "definition": "http://example.org/def/press", "uom": { "code": "hPa" } },
    { "name": "station", "type": "Text", "definition": "http://example.org/def/station" }
  ]
}
