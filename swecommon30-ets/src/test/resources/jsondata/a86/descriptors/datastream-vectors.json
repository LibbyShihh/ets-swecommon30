{
  "type": "DataStream",
  "label": "Navigation data",
  "elementType": {
    "name": "navData",
    "type": "DataRecord",
    "fields": [
      {
        "name": "time",
        "type": "Time",
        "definition": "http://www.opengis.net/def/property/OGC/0/SamplingTime",
        "uom": { "href": "http://www.opengis.net/def/uom/ISO-8601/0/Gregorian" }
      },
      { "name": "temp", "type": "Quantity", "definition": "http://example.org/def/temp", "uom": { "code": "Cel" } },
      {
        "name": "position",
        "type": "Vector",
        "label": "Position",
        "definition": "http://example.org/def/position",
        "referenceFrame": "http://www.opengis.net/def/crs/EPSG/0/4979",
        "coordinates": [
          { "name": "lat", "type": "Quantity", "definition": "http://example.org/def/lat", "axisID": "Lat", "uom": { "code": "deg" } },
          { "name": "lon", "type": "Quantity", "definition": "http://example.org/def/lon", "axisID": "Lon", "uom": { "code": "deg" } },
          { "name": "alt", "type": "Quantity", "definition": "http://example.org/def/alt", "axisID": "h", "uom": { "code": "m" } }
        ]
      },
      {
        "name": "velocity",
        "type": "Vector",
        "optional": true,
        "label": "Velocity",
        "definition": "http://example.org/def/velocity",
        "referenceFrame": "http://example.org/def/frame/ENU",
        "coordinates": [
          { "name": "vx", "type": "Quantity", "definition": "http://example.org/def/vx", "axisID": "X", "uom": { "code": "m/s" } },
          { "name": "vy", "type": "Quantity", "definition": "http://example.org/def/vy", "axisID": "Y", "uom": { "code": "m/s" } }
        ]
      }
    ]
  },
  "encoding": { "type": "JSONEncoding" }
}
