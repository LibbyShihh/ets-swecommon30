      {
        "name": "temps",
        "type": "DataArray",
        "elementCount": { "type": "Count", "value": 2 },
        "elementType": { "name": "temp", "type": "Quantity", "definition": "http://example.org/def/temp", "uom": { "code": "Cel" } }
      }
